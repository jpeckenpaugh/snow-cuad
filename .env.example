# =============================================================================
# CUAD POC - environment file
#
# `make bootstrap` copies this to .env (if absent) and chmod 600's it.
# .env is gitignored. Fill in every value marked CHANGE_ME.
# =============================================================================

# --- Snowflake connection ----------------------------------------------------
# Account identifier, NOT the full URL and NOT the hostname.
#   org-account form:  myorg-myaccount
#   legacy locator :   xy12345.us-east-1
# Find it: Snowflake UI -> bottom-left account menu -> "Account identifier".
SNOWFLAKE_ACCOUNT=CHANGE_ME

# Your Snowflake login name (not your email necessarily).
SNOWFLAKE_USER=CHANGE_ME

# Role used for setup and all app queries.
# ACCOUNTADMIN is fine for a throwaway trial; use a dedicated role otherwise.
SNOWFLAKE_ROLE=ACCOUNTADMIN

# Target objects, created by sql/00_setup.sql.
SNOWFLAKE_DATABASE=CUAD_DB
SNOWFLAKE_SCHEMA=CORPUS

# NOTE: there is deliberately no SNOWFLAKE_WAREHOUSE here. The warehouse
# (CUAD_WH) does not exist until setup runs, and every SQL script and query
# names it explicitly.

# --- Authentication: choose ONE block ----------------------------------------
# A) Key-pair (recommended: unaffected by Snowflake's MFA-for-passwords policy)
SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE_JWT
SNOWFLAKE_PRIVATE_KEY_PATH=./keys/snowflake_key.p8
# Only needed if the private key is encrypted. Leave empty for the key that
# `make keypair` generates.
PRIVATE_KEY_PASSPHRASE=

# B) Password (simplest; may demand an MFA passcode, poor fit for scripting)
# SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE
# SNOWFLAKE_PASSWORD=
